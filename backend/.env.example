# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Database (Prisma / Postgres, e.g. Supabase)
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Anthropic (report generation)
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_ERROR_TEMPLATE_SID=

# Cloudflare (KV / R2)
CF_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Admin Auth (JWT)
ADMIN_JWT_SECRET=

# Misc
BLESS_KEY=
